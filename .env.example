# VeriTac LLM demo config — copy to `.env` and fill in.
# The demo reads OPENAI_API_KEY from env, from this file, or asks on the prompt.
OPENAI_API_KEY=sk-

# Optional: OpenAI-compatible base URL (proxy / self-hosted gateway).
# May be a bare base (".../api/v1") or a full endpoint (".../api/v1/chat/completions");
# the demo normalizes either form.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: model ID to send to the gateway.
# OPENAI_MODEL=gpt-4o-mini